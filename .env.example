# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
# Note: Vite environment variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put service_role secret keys here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional configuration
# Default storage bucket name (defaults to "assignments" if unset)
VITE_SUPABASE_STORAGE_BUCKET=assignments

# Maximum allowed file upload size in Megabytes (defaults to 25 if unset)
VITE_MAX_FILE_SIZE_MB=25

